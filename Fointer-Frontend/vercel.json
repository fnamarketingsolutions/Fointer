{
  "rewrites": [
    {
      "source": "/post/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(twitterbot|facebookexternalhit|facebot|whatsapp|linkedinbot|slackbot|discordbot|telegrambot|pinterest|redditbot|embedly|iframely|skypeuripreview|vkshare|tumblr|bitlybot).*"
        }
      ],
      "destination": "https://api.fointer.net/share/post/:slug"
    },
    {
      "source": "/communities/:communityId/posts/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(twitterbot|facebookexternalhit|facebot|whatsapp|linkedinbot|slackbot|discordbot|telegrambot|pinterest|redditbot|embedly|iframely|skypeuripreview|vkshare|tumblr|bitlybot).*"
        }
      ],
      "destination": "https://api.fointer.net/share/post/:slug"
    },
    {
      "source": "/manage-community/:communityId/posts/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(twitterbot|facebookexternalhit|facebot|whatsapp|linkedinbot|slackbot|discordbot|telegrambot|pinterest|redditbot|embedly|iframely|skypeuripreview|vkshare|tumblr|bitlybot).*"
        }
      ],
      "destination": "https://api.fointer.net/share/post/:slug"
    },
    {
      "source": "/communities/manage/:communityId/posts/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(twitterbot|facebookexternalhit|facebot|whatsapp|linkedinbot|slackbot|discordbot|telegrambot|pinterest|redditbot|embedly|iframely|skypeuripreview|vkshare|tumblr|bitlybot).*"
        }
      ],
      "destination": "https://api.fointer.net/share/post/:slug"
    },
    {
      "source": "/((?!push-sw\\.js|manifest\\.webmanifest|favicon\\.svg|robots\\.txt|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/push-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
